# Base URLs
AQA_BASE_URL=https://playwright.dev/
AQA_API_BASE_URL=

# Browser
AQA_VIEWPORT_WIDTH=1440
AQA_VIEWPORT_HEIGHT=900
AQA_LOCALE=ru-RU

# Timeouts (ms)
AQA_DEFAULT_TIMEOUT_MS=15000
AQA_NAVIGATION_TIMEOUT_MS=30000

# Data & CI
AQA_SEED=42
AQA_ARTIFACTS_DIR=artifacts

# Secrets - never commit real values
AQA_LOGIN=
AQA_PASSWORD=

# Set to 1 to enable tests marked `live`
RUN_LIVE_TESTS=0
